NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional legacy JWT anon key (Settings → API) if publishable key is not used
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: server-only, bypasses RLS (recommended for production API routes)
SUPABASE_SERVICE_ROLE_KEY=

# Meta Pixel (public) + Conversions API (server-only — never use NEXT_PUBLIC_ for the token)
NEXT_PUBLIC_META_PIXEL_ID=1395419915853207
META_CAPI_ACCESS_TOKEN=
# Optional: Meta Events Manager → Test events (omit in production)
NEXT_PUBLIC_META_TEST_EVENT_CODE=

# Supabase Database Webhook → POST /api/meta-purchase (header x-webhook-secret)
WEBHOOK_SECRET=